#dlg.day-overview-dialog
  width calc(100% - 32px)
  max-width 440px
  max-height 85vh
  padding 22px
  border 1px solid var(--ln)
  border-radius 22px
  background var(--card)
  color var(--tx)
  box-shadow var(--sh)
  overflow-y auto

  &::backdrop
    background rgba(30, 20, 50, .45)
    backdrop-filter blur(5px)

.overview
  width 100%

  &__head
    display flex
    justify-content space-between
    align-items flex-start
    margin-bottom 22px

  &__date
    color var(--mut)
    font-size 13px

  &__close
    border 0
    background var(--ac2)
    color var(--tx)
    width 34px
    height 34px
    border-radius 11px
    cursor pointer

  &__stats
    display grid
    grid-template-columns repeat(2, 1fr)
    gap 10px

  &__item
    display flex
    flex-direction column
    gap 5px
    padding 15px
    border-radius 15px
    background var(--ac2)

    span
      font-size 19px

    b
      font-size 24px

    small
      color var(--mut)
      font-size 12px

  &__notes
    margin-top 22px

    h3
      font-size 16px
      margin 0 0 12px

  &__note
    padding 12px
    margin-bottom 8px
    border-radius 12px
    background var(--pk)
    font-size 14px
    line-height 1.5
    overflow-wrap anywhere

  &__empty
    padding 15px
    border-radius 12px
    background var(--ac2)
    color var(--mut)
    font-size 13px
    text-align center

@media (max-width: 420px)
  #dlg.day-overview-dialog
    padding 17px

  .overview__item
    padding 12px

    b
      font-size 21px