@import '../components/habit-tracker/habit-tracker.styl';
@import '../components/day-overview/day-overview.styl';

:root
  --bg1: #EDE7F6
  --bg2: #F8EAF0
  --card: rgba(255, 255, 255, .8)
  --tx: #2b2540
  --mut: #756f8c
  --ac: #8d7ae0
  --ac2: #DCD6F7
  --sg: #E5EBDD
  --pk: #F8EAF0
  --ln: rgba(120, 100, 180, .2)
  --sh: 0 8px 24px rgba(110, 90, 170, .12)
  --star: rgba(141, 122, 224, .35)

[data-theme='dark']
  --bg1: #16132e
  --bg2: #271b3d
  --card: rgba(42, 35, 74, .82)
  --tx: #ece8fa
  --mut: #a39cc4
  --ac: #a99cf2
  --ac2: #3a3366
  --sg: #2d3a35
  --pk: #3b2a45
  --ln: rgba(190, 175, 255, .18)
  --sh: 0 8px 24px rgba(0, 0, 0, .35)
  --star: rgba(255, 255, 255, .6)

*
  box-sizing border-box

body
  margin 0
  font 15px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif
  color var(--tx)
  min-height 100vh
  background radial-gradient(1.5px 1.5px at 30px 40px, var(--star) 50%, transparent), radial-gradient(1px 1px at 120px 90px, var(--star) 50%, transparent), radial-gradient(1.5px 1.5px at 80px 150px, var(--star) 50%, transparent), linear-gradient(160deg, var(--bg1), var(--bg2))
  background-size 170px 190px, 170px 190px, 170px 190px, 100% 100%
  background-attachment fixed

.wrap
  max-width 1380px
  margin 0 auto
  padding 18px
  padding-left 196px

header
  display flex
  justify-content space-between
  align-items center
  gap 12px
  flex-wrap wrap
  margin-bottom 14px

h1
  margin 0
  font-size 26px

  span
    color var(--ac)

h2
  margin 0 0 10px
  font-size 17px

.mut
  color var(--mut)
  font-size 13px

.grid
  display grid
  grid-template-columns 1fr 1fr
  gap 16px

.card
  background var(--card)
  border 1px solid var(--ln)
  border-radius 20px
  padding 16px
  box-shadow var(--sh)
  backdrop-filter blur(6px)
  min-width 0

.full
  grid-column 1 / -1

button,
input,
select,
textarea
  font inherit
  color var(--tx)

.btn
  border 1px solid var(--ln)
  background var(--ac2)
  border-radius 12px
  padding 7px 13px
  cursor pointer
  transition .15s

  &:hover
    transform translateY(-1px)
    filter brightness(1.05)

.pri
  background var(--ac)
  color #fff
  border-color transparent

.ib
  border 0
  background transparent
  cursor pointer
  font-size 16px
  padding 3px 5px
  border-radius 8px

  &:hover
    background var(--ac2)

input,
select,
textarea
  background var(--card)
  border 1px solid var(--ln)
  border-radius 10px
  padding 7px 10px
  width 100%

textarea
  resize vertical
  min-height 62px

.row
  display flex
  gap 8px
  align-items center
  flex-wrap wrap

.sp
  justify-content space-between

.pick
  display flex
  gap 6px

  button
    width 38px
    height 38px
    border-radius 12px
    border 1px solid var(--ln)
    background var(--card)
    cursor pointer
    font-size 18px
    transition .15s

    &.on
      background var(--ac)
      color #fff
      transform scale(1.1)

.sod
  display grid
  grid-template-columns auto auto 1fr
  gap 18px
  align-items end

// Calendar

.cal
  display grid
  grid-template-columns repeat(7, 1fr)
  gap 4px
  text-align center

  .wd
    font-size 12px
    color var(--mut)

.day
  aspect-ratio 1
  min-height 58px
  border 1px solid transparent
  border-radius 12px
  background transparent
  cursor pointer
  position relative
  padding 4px 3px 14px

  &:hover
    background var(--ac2)

  &.out
    opacity .35

  &.today
    border-color var(--ac)
    font-weight 700

  &.sel
    background var(--ac)
    color #fff

  &-rating
    display flex
    flex-direction column
    gap 3px
    width 75%
    margin 4px auto 0

    &__line
      width 100%
      height 4px
      background var(--ln)
      border-radius 10px
      overflow hidden

    &__energy
      display block
      height 100%
      background #e9b85d
      border-radius 10px

    &__mood
      display block
      height 100%
      background var(--ac)
      border-radius 10px

.dots
  position absolute
  bottom 4px
  left 0
  right 0
  display flex
  justify-content center
  gap 3px

  i
    width 5px
    height 5px
    border-radius 50%
    background var(--ac)

    &.n
      background #e58fb0

.day.sel .dots i
  background #fff

.mt
  text-transform capitalize
  font-weight 600

// Tasks

ul
  list-style none
  margin 0
  padding 0

#tasks
  max-height 420px
  overflow-y auto
  padding-right 4px
  overscroll-behavior contain

.task
  display flex
  gap 10px
  align-items flex-start
  padding 9px 6px
  border-bottom 1px solid var(--ln)
  animation fade-in .25s

@keyframes fade-in
  from
    opacity 0
    transform translateY(4px)

.chk
  width 24px
  height 24px
  border-radius 50%
  border 2px solid var(--ac)
  background transparent
  cursor pointer
  flex none
  color #fff
  font-size 13px
  line-height 1
  margin-top 1px

.done
  .chk
    background var(--ac)

  .tt
    text-decoration line-through
    opacity .5

.tb
  flex 1
  min-width 0

.tt
  word-break break-word

.tm
  display flex
  gap 6px
  flex-wrap wrap
  font-size 12px
  color var(--mut)
  margin-top 3px

.badge
  border-radius 20px
  padding 1px 9px
  color var(--tx)
  font-size 12px
  border 1px solid var(--ln)

.tn
  font-size 13px
  color var(--mut)
  margin-top 3px
  white-space pre-wrap

.ta
  display flex
  flex none

.chips
  display flex
  gap 6px
  flex-wrap wrap
  margin 8px 0

  .btn
    padding 3px 10px
    font-size 13px

  .on
    background var(--ac)
    color #fff

.empty
  text-align center
  color var(--mut)
  padding 18px 6px

// Cat game

.track
  position relative
  height 110px
  border-radius 16px
  background var(--sg)
  overflow hidden
  border 1px dashed var(--ln)

  &:before
    content ""
    position absolute
    left 60px
    right 70px
    top 70%
    border-top 3px dotted var(--ac)

  .path
    position absolute
    inset 0
    width 100%
    height 100%
    object-fit fill

.cat
  position absolute
  bottom 8px
  width 60px
  height 60px
  transition left 1.1s cubic-bezier(.4, .1, .2, 1)

.yarn
  position absolute
  right 8px
  bottom 8px
  width 60px
  height 60px

.cat img,
.yarn img
  width 100%
  height 100%
  object-fit contain

.ph
  display none
  font-size 42px
  text-align center
  line-height 60px

.bar
  height 10px
  background var(--ac2)
  border-radius 10px
  margin 10px 0
  overflow hidden

  i
    display block
    height 100%
    background var(--ac)
    transition width .8s

.stats
  display grid
  grid-template-columns repeat(4, 1fr)
  gap 8px
  text-align center

  div
    background var(--pk)
    border-radius 12px
    padding 8px 4px

  b
    display block
    font-size 18px

// Timer

.tdisp
  font-size 46px
  font-weight 700
  text-align center
  font-variant-numeric tabular-nums

.wk
  display flex
  gap 8px
  align-items flex-end
  height 110px
  margin-top 8px

  div
    flex 1
    text-align center
    font-size 11px
    color var(--mut)

  i
    display block
    background var(--ac)
    border-radius 6px 6px 0 0
    min-height 3px
    margin-bottom 3px

.hab
  display flex
  align-items center
  gap 8px
  padding 6px 0
  border-bottom 1px solid var(--ln)

.note
  background var(--pk)
  border-radius 12px
  padding 8px 10px
  margin-top 8px
  white-space pre-wrap
  display flex
  gap 6px
  justify-content space-between

dialog
  border 1px solid var(--ln)
  border-radius 20px
  background var(--bg1)
  color var(--tx)
  width 100%
  max-width 400px
  padding 18px
  box-shadow var(--sh)
  max-height 90vh
  overflow auto

  &::backdrop
    background rgba(30, 20, 60, .45)

dialog::backdrop
  background rgba(30, 20, 50, .35)
  backdrop-filter blur(6px)
  -webkit-backdrop-filter blur(6px)

.ff
  display grid
  gap 10px
  margin 10px 0

  label
    display grid
    gap 3px
    font-size 13px
    color var(--mut)

.cl
  li
    display flex
    justify-content space-between
    align-items center
    padding 6px 0

#toast
  position fixed
  left 50%
  bottom 22px
  transform translate(-50%, 80px)
  background var(--ac)
  color #fff
  padding 9px 18px
  border-radius 20px
  transition .3s
  z-index 9

  &.on
    transform translate(-50%, 0)

[hidden]
  display none !important

// Navigation

#nav
  position fixed
  left 0
  top 0
  bottom 0
  width 178px
  padding 16px 10px
  display flex
  flex-direction column
  gap 4px
  background var(--card)
  border-right 1px solid var(--ln)
  backdrop-filter blur(8px)
  z-index 5

  b
    font-size 18px
    padding 4px 10px 14px

  button
    display flex
    gap 9px
    align-items center
    border 0
    background transparent
    padding 9px 12px
    border-radius 12px
    cursor pointer
    text-align left
    transition .15s

    &:hover
      background var(--ac2)

    &.on
      background var(--ac)
      color #fff

  #theme2
    margin-top auto

.nav-icon
  height 24px
  width 24px

// Finance

.kpis
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 12px
  margin-bottom 16px

.kpi b
  display block
  font-size 22px

.hb
  display flex
  align-items center
  gap 8px
  margin 6px 0
  font-size 13px

  span
    width 100px
    flex none

  div
    flex 1

  i
    display block
    height 12px
    border-radius 8px
    background var(--ac)
    min-width 3px
    transition width .6s

.pos
  color #4f9a6a

.neg
  color #d0607f

.tabs
  display flex
  gap 6px
  flex-wrap wrap
  margin 4px 0 12px

  .on
    background var(--ac)
    color #fff

.dot
  display inline-block
  width 14px
  height 14px
  border-radius 50%
  background var(--ac2)
  margin-right 4px

  &.on
    background var(--ac)

// Books

.case
  background linear-gradient(#cdbb9f, #b9a283)
  border-radius 18px
  padding 14px 14px 4px
  box-shadow inset 0 0 0 5px #a18a6b, var(--sh)

[data-theme='dark'] .case
  background linear-gradient(#4d3d57, #3a2d44)
  box-shadow inset 0 0 0 5px #5f4c6e, var(--sh)

.shelf h3
  margin 2px 6px 4px
  font-size 15px
  color #4a3b2a

[data-theme='dark'] .shelf h3
  color #e6dcf5

.books
  display flex
  gap 10px
  align-items flex-end
  min-height 150px
  padding 10px 12px 0
  background rgba(60, 40, 20, .14)
  box-shadow inset 0 6px 10px rgba(0, 0, 0, .18)
  border-radius 8px 8px 0 0
  overflow-x auto

.plank
  height 16px
  background linear-gradient(#e0cdac, #b59a74)
  border-radius 0 0 8px 8px
  box-shadow 0 7px 8px rgba(0, 0, 0, .25)
  margin-bottom 16px

[data-theme='dark'] .plank
  background linear-gradient(#7a6590, #5b4968)

.bk
  width 88px
  height 128px
  flex none
  border-radius 3px 7px 7px 3px
  background-size cover
  background-position center
  cursor pointer
  box-shadow inset 7px 0 6px -4px rgba(0, 0, 0, .35), 3px 3px 7px rgba(0, 0, 0, .3)
  transition transform .2s
  display flex
  flex-direction column
  justify-content center
  align-items center
  text-align center
  padding 8px 6px
  color #3a3150
  overflow hidden
  font-size 12px
  font-weight 600
  word-break break-word

  small
    font-weight 400
    font-size 10px
    margin-top 4px

  &:hover
    transform translateY(-9px) rotate(-1.5deg)

// Wishlist

.wg
  display grid
  grid-template-columns repeat(auto-fill, minmax(210px, 1fr))
  gap 14px

.wc
  padding 0
  overflow hidden

  .im
    aspect-ratio 4 / 3
    background linear-gradient(135deg, var(--ac2), var(--pk)) center / cover
    display grid
    place-items center
    font-size 42px

  .bd
    padding 12px

// Ideas

.ig
  display grid
  grid-template-columns 1fr 1fr
  gap 14px

.idea
  border-left 4px solid
  border-radius 10px
  background var(--pk)
  padding 8px 10px
  margin-top 8px

.tag
  font-size 11px
  background var(--ac2)
  border 0
  border-radius 10px
  padding 1px 8px
  margin-right 4px
  cursor pointer

// Achievements

.ach
  background linear-gradient(135deg, var(--pk), var(--ac2))
  border-radius 16px
  padding 12px 14px
  margin-top 10px
  animation fade-in .25s

// Responsive

@media (max-width: 860px)
  .grid
    grid-template-columns 1fr

  .sod
    grid-template-columns 1fr

  .ig
    grid-template-columns 1fr

  .wrap
    padding 12px 12px 84px

  #nav
    top auto
    width auto
    right 0
    flex-direction row
    overflow-x auto
    padding 6px
    border-right 0
    border-top 1px solid var(--ln)

    b
      display none

    button
      flex-direction column
      gap 0
      font-size 11px
      padding 6px 9px
      flex none

    #theme2
      margin-top 0

@media (max-width: 560px)
  .stats
    grid-template-columns repeat(2, 1fr)

  .kpis
    grid-template-columns 1fr


#tasks,
#tmin
  max-height 420px
  overflow-y auto
  padding-right 4px
  overscroll-behavior contain

  // Firefox
  scrollbar-width thin
  scrollbar-color var(--ac) transparent

  // Chrome, Edge, Safari
  &::-webkit-scrollbar
    width 6px

  &::-webkit-scrollbar-track
    background transparent
    border-radius 10px

  &::-webkit-scrollbar-thumb
    background var(--ac)
    border-radius 10px
    opacity .6

  &::-webkit-scrollbar-thumb:hover
    background var(--ac)

#notes
  margin-top 14px